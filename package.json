{
  "name": "tradingweb-pos",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:native",
    "i18n:check": "tsx scripts/i18n-hardcoded.ts",
    "test:unit": "vitest run",
    "test:native": "jest --runInBand",
    "lint": "eslint app src --max-warnings=0",
    "bundle:android": "expo export:embed --platform android --dev false --entry-file node_modules/expo-router/entry.js --bundle-output .expo-audit/index.android.bundle --assets-dest .expo-audit/assets",
    "perf:android": "powershell -ExecutionPolicy Bypass -File scripts/perf/android-runtime.ps1",
    "android:release:aab": "powershell -ExecutionPolicy Bypass -File scripts/build/android-release.ps1 -Mode aab",
    "android:release:arm64": "powershell -ExecutionPolicy Bypass -File scripts/build/android-release.ps1 -Mode arm64"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "buffer": "^6.0.3",
    "expo": "~53.0.9",
    "expo-camera": "~16.1.6",
    "expo-constants": "~17.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.1",
    "expo-linking": "~7.1.5",
    "expo-print": "~14.1.4",
    "expo-router": "~5.0.7",
    "expo-secure-store": "~14.2.3",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "iconv-lite": "^0.6.3",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-ble-plx": "^3.2.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-tcp-socket": "^6.2.0",
    "string_decoder": "^1.3.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.2.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.0.10",
    "eslint": "9.39.2",
    "eslint-config-expo": "9.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.14",
    "test-renderer": "1.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "vitest": "^2.1.8"
  },
  "private": true
}
